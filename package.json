{
  "name": "durable-execution-engine",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "A durable execution engine: workflows and steps that survive process crashes.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:sticky": "node --conditions=development ./packages/worker/src/bench/run-sticky-bench.ts",
    "bench:explain": "node --conditions=development ./packages/worker/src/bench/run-explain.ts",
    "bench": "node --conditions=development ./packages/worker/src/bench/run-bench.ts",
    "migrate:up": "pnpm --filter @dee/core run migrate:up",
    "migrate:down": "pnpm --filter @dee/core run migrate:down",
    "example:payment": "node packages/cli/bin/wf.js example payment-saga",
    "example:etl": "node packages/cli/bin/wf.js example etl-pipeline",
    "test:examples": "vitest run examples packages/cli",
    "history-gate:record": "node --conditions=development test/fixtures/history-gate/record.ts && prettier --write test/fixtures/history-gate/histories",
    "build": "tsc -b tsconfig.build.json",
    "api:check": "pnpm run build && node scripts/api-report.mjs",
    "api:update": "pnpm run build && node scripts/api-report.mjs --update",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@dee/cli": "workspace:*",
    "@dee/core": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.8",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
