{
  "name": "@dee/api",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "HTTP api surface: rest endpoints, authentication, quotas and rate limiting.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@dee/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utkutvskin/durable-execution-engine.git",
    "directory": "packages/api"
  }
}
