{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "customConditions": [],
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src"],
