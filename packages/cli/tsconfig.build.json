    {
      "path": "../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../apps/ui/tsconfig.build.json"
    },
    {
      "path": "../../examples/payment-saga/tsconfig.build.json"
    },
    {
      "path": "../../examples/etl-pipeline/tsconfig.build.json"
