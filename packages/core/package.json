{
  "name": "@dee/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Core runtime: event store, replay engine, workflow dsl and persistence.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "migrate:up": "pnpm run build && node dist/db/cli.js up",
    "migrate:down": "pnpm run build && node dist/db/cli.js down"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
