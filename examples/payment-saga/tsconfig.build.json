{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "customConditions": [],
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/test-support.ts",
    "src/client",
    "src/fixtures",
    "src/chaos",
    "src/bench"
  ],
  "references": [
    {
      "path": "../../packages/core/tsconfig.build.json"
    }
  ]
}
