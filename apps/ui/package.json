{
  "name": "@dee/ui",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Run explorer web ui: run list, event timeline, signals and live updates.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "src/client",
    "!src/client/**/*.test.ts",
    "!src/client/tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {},
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utkutvskin/durable-execution-engine.git",
    "directory": "apps/ui"
  }
}
